<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Deepwoken Reaction Trainer - Parry & Boss Practice</title>
<meta name="description" content="Improve your Deepwoken skills! Practice parry timings, dodge mechanics, and boss fights against Primadon, Duke Erisia, Ferryman and Maestro.">
<meta name="keywords" content="deepwoken, deepwoken training, deepwoken practice, parry trainer, roblox deepwoken">
<style>
:root{color-scheme:dark;--bg:#10131a;--panel:#1b2230;--line:#303b50;--text:#f3f5fb;--muted:#aeb8ca;--accent:#8fb4ff;--danger:#ff5c5c;--success:#4caf50}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at top,#202c42,#10131a 65%);color:var(--text);font:16px system-ui,Segoe UI,sans-serif;min-height:100vh;display:grid;place-items:center;padding:20px;user-select:none}
main{width:min(820px,100%)}h1{margin:0 0 6px;font-size:clamp(27px,5vw,40px)}p{color:var(--muted);line-height:1.5}.panel{background:#1b2230eF;border:1px solid var(--line);border-radius:18px;padding:20px;margin-top:16px;box-shadow:0 15px 50px #0004}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}.row>*{flex:1}
label{display:block;color:var(--muted);font-size:13px;margin-bottom:6px}select,input,button{font:inherit;border-radius:11px;border:1px solid var(--line);padding:12px;background:#111722;color:var(--text);width:100%}
button{cursor:pointer;font-weight:700}
button.primary{background:var(--accent);color:#101722;border-color:transparent}
button.danger{background:var(--danger);color:#fff;border-color:transparent}
button:disabled{opacity:.45;cursor:not-allowed}
#cue{min-height:210px;display:grid;place-items:center;text-align:center;border:1px dashed #46536c;border-radius:16px;margin-top:16px;background:#121925;position:relative;overflow:hidden;cursor:crosshair}
#cue strong{display:block;font-size:clamp(22px,5vw,36px);letter-spacing:1px}#cue span{display:block;color:var(--muted);margin-top:8px}
.signal-orb{width:100px;height:100px;border-radius:50%;display:grid;place-items:center;margin:0 auto 10px;border:5px solid #ffffffa8;box-shadow:inset 0 0 0 5px #0003,0 0 28px currentColor;font-size:32px;font-weight:900;text-shadow:0 2px 4px #0008}
.signal-orb.red{background:radial-gradient(circle at 30% 25%,#ffb1a6,#e43b37 55%,#8e151b);color:#fff}
.signal-orb.gray{background:radial-gradient(circle at 30% 25%,#f2f4f7,#8b95a4 55%,#4a5360);color:#111827}
.signal-orb.blue{background:radial-gradient(circle at 30% 25%,#b8e9ff,#409de7 55%,#1751a5);color:#fff}
.signal-orb.purple{background:radial-gradient(circle at 30% 25%,#efc6ff,#a94fe0 55%,#54218c);color:#fff}
#cue.ready .signal-orb{display:none}
.keys{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:14px}.keys button{min-height:72px}.keys b{display:block;font-size:18px}.keys small{color:var(--muted)}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:14px}.stat{background:#111722;border-radius:12px;padding:12px}.stat span{color:var(--muted);font-size:12px;display:block}.stat strong{font-size:20px}
.hp-bars{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px}
.hp-card{background:#111722;padding:12px;border-radius:12px;border:1px solid var(--line)}
.hp-bar-bg{width:100%;height:16px;background:#2a3446;border-radius:8px;overflow:hidden;margin-top:6px}
.hp-bar-fill{height:100%;width:100%;transition:width .2s ease-in-out}
.player-hp{background:var(--success)}.boss-hp{background:var(--danger)}
#phase-badge{display:none;background:#ff9800;color:#000;font-weight:bold;padding:4px 8px;border-radius:6px;font-size:12px;margin-left:8px}
#message{min-height:24px;margin-top:12px;color:var(--muted)}.hint{font-size:13px}
.leaderboard-table{width:100%;border-collapse:collapse;margin-top:10px;font-size:14px}
.leaderboard-table th,.leaderboard-table td{padding:8px 12px;text-align:left;border-bottom:1px solid var(--line)}
.leaderboard-table th{color:var(--muted)}
@media(max-width:540px){.keys{grid-template-columns:repeat(2,1fr)}.stats{grid-template-columns:repeat(2,1fr)}.panel{padding:14px}.hp-bars{grid-template-columns:1fr}}
</style>
</head>
<body><main>
<h1>Deepwoken Reaction & Boss Trainer</h1>
<p>Parry/Dodge boss attacks, then click Left Mouse Button (LMB) to execute combo attacks during the opening window!</p>
<div class="panel">
 <div class="row">
  <div>
    <label for="username">Player Nickname</label>
    <input type="text" id="username" placeholder="Enter your name" maxlength="15" value="Player1">
  </div>
  <div>
    <label for="boss">Select Boss</label>
    <select id="boss">
      <option value="random">Free Practice (Dummy)</option>
      <option value="primadon" selected>Primadon (40,000 HP)</option>
      <option value="elder_primadon">Elder Primadon (90,000 HP)</option>
      <option value="maestro">Maestro Evengarde (15,000 HP)</option>
      <option value="duke">Duke Erisia (15,000 HP)</option>
      <option value="ferryman">Ferryman (15,000 HP)</option>
    </select>
  </div>
  <div>
    <label for="weapon">Select Weapon Class</label>
    <select id="weapon">
      <option value="heavy">Heavy (1,200 DMG · 1 Hit)</option>
      <option value="medium" selected>Medium (600 DMG · 2 Hits Combo)</option>
      <option value="light">Light (300 DMG · 3 Hits Combo)</option>
    </select>
  </div>
  <div>
    <label for="difficulty">Difficulty</label>
    <select id="difficulty">
      <option value="easy">Easy</option>
      <option value="normal" selected>Normal</option>
      <option value="hard">Hard</option>
      <option value="expert">Expert</option>
      <option value="extreme">Extreme</option>
      <option value="impossible">Impossible</option>
    </select>
  </div>
  <div>
    <label for="rounds">Rounds</label>
    <select id="rounds">
      <option value="20">20</option>
      <option value="50" selected>50</option>
      <option value="75">75</option>
      <option value="100">100</option>
    </select>
  </div>
  <div style="flex: 0 0 100%; display: flex; gap: 10px; margin-top: 5px;">
    <button id="start" class="primary" onclick="startPractice()">Start Combat</button>
    <button id="end-btn" class="danger" onclick="stopPractice()" disabled>End Combat</button>
  </div>
 </div>

 <div class="hp-bars">
  <div class="hp-card">
    <div style="display:flex;justify-content:space-between"><span>Player HP</span><strong id="player-hp-text">600/600</strong></div>
    <div class="hp-bar-bg"><div id="player-hp-fill" class="hp-bar-fill player-hp"></div></div>
  </div>
  <div class="hp-card">
    <div style="display:flex;justify-content:space-between">
      <div><span id="boss-name-label">Boss HP</span><span id="phase-badge">PHASE 2</span></div>
      <strong id="boss-hp-text">40000/40000</strong>
    </div>
    <div class="hp-bar-bg"><div id="boss-hp-fill" class="hp-bar-fill boss-hp"></div></div>
  </div>
 </div>

 <div id="cue"><div><strong>READY?</strong><span>Select settings and click "Start Combat"</span></div></div>

 <div class="keys">
  <button data-action="DODGE" disabled><b>Q</b><small>🔴 Roll / Dodge</small></button>
  <button data-action="PARRY" disabled><b>F</b><small>⚪ Parry</small></button>
  <button data-action="CROUCH" disabled><b>Ctrl</b><small>🔵 Crouch</small></button>
  <button data-action="JUMP" disabled><b>Space</b><small>🟣 Jump</small></button>
 </div>

 <div class="stats">
  <div class="stat"><span>Round</span><strong id="round">0/50</strong></div>
  <div class="stat"><span>Accuracy</span><strong id="accuracy">—</strong></div>
  <div class="stat"><span>Avg Response</span><strong id="average">—</strong></div>
  <div class="stat"><span>Your PvE Score</span><strong id="pve-score" style="color:var(--accent)">0</strong></div>
 </div>
 <div id="message" role="status">Defend with keyboard, then CLICK ANYWHERE to attack during opening window!</div>
</div>

<!-- Блок Таблицы Лидеров -->
<div class="panel">
  <h3 style="margin:0 0 10px;font-size:18px">🏆 Leaderboard (Top Players)</h3>
  <table class="leaderboard-table">
    <thead>
      <tr>
        <th>#</th>
        <th>Player</th>
        <th>PvE Score</th>
      </tr>
    </thead>
    <tbody id="leaderboard-body">
      <!-- Автоматически заполняется при победах -->
    </tbody>
  </table>
</div>

<div class="panel hint">
  <b>PvE Score Rewards:</b> 100% Accuracy = <b>+3 Score</b> | 90-99% Accuracy = <b>+2 Score</b> | 40-89% Accuracy = <b>+1 Score</b>.
</div>
</main>

<script>
const $=id=>document.getElementById(id);
const names={PARRY:"PARRY",DODGE:"ROLL / DODGE",JUMP:"JUMP",CROUCH:"CROUCH"};
const colors={PARRY:"gray",DODGE:"red",JUMP:"purple",CROUCH:"blue"};
const symbols={PARRY:"F",DODGE:"Q",JUMP:"↑",CROUCH:"↓"};

const weapons = {
  heavy: { name: "Heavy", dmg: 1200, maxCombo: 1, cooldown: 400 },
  medium: { name: "Medium", dmg: 600, maxCombo: 2, cooldown: 200 },
  light: { name: "Light", dmg: 300, maxCombo: 3, cooldown: 120 }
};

const bossStats = {
  random: { name: "Target Dummy", hp: 10000, damage: 50, diff: "normal", moves: ["PARRY","DODGE","JUMP","CROUCH"] },
  primadon: { name: "Primadon", hp: 40000, damage: 80, diff: "normal", moves: ["PARRY","DODGE"] },
  elder_primadon: { name: "Elder Primadon", hp: 90000, damage: 110, diff: "hard", moves: ["PARRY","DODGE","JUMP"] },
  maestro: { name: "Maestro Evengarde", hp: 15000, damage: 70, diff: "hard", moves: ["PARRY","DODGE","CROUCH"] },
  duke: { name: "Duke Erisia", hp: 15000, damage: 65, diff: "normal", moves: ["PARRY","DODGE","CROUCH"] },
  ferryman: { name: "Ferryman", hp: 15000, damage: 75, diff: "expert", moves: ["PARRY","DODGE","JUMP"] }
};

let active=false, waiting=false, canAttack=false, attackTimer=null, target="", shownAt=0, timer=null, gapTimer=null, index=0, total=50, hits=0, times=[], results=[];
let playerMaxHp=600, playerHp=600, bossMaxHp=40000, bossHp=40000;
let isPhaseTwo=false, lastAttackTime=0, currentComboHits=0;
let totalPveScore = Number(localStorage.getItem("pve_score") || 0);

function enable(on){document.querySelectorAll("[data-action]").forEach(b=>b.disabled=!on)}

function cue(title,sub,action=null){
 const box=$("cue");
 if(action){box.classList.remove("ready");box.innerHTML=`<div><div class="signal-orb ${colors[action]}">${symbols[action]}</div><strong>${title}</strong><span>${sub}</span></div>`}
 else {box.classList.add("ready");box.innerHTML=`<div><strong>${title}</strong><span>${sub}</span></div>`}
}

function getDifficultySettings() {
  const bossKey = $("boss").value;
  const diff = bossKey === "random" ? $("difficulty").value : bossStats[bossKey].diff;
  
  let base = { minDelay: 400, addDelay: 650, timeout: 680 };
  if(diff === "easy") base = { minDelay: 1000, addDelay: 1200, timeout: 1400 };
  else if(diff === "normal") base = { minDelay: 700, addDelay: 950, timeout: 1050 };
  else if(diff === "hard") base = { minDelay: 450, addDelay: 700, timeout: 780 };
  else if(diff === "expert") base = { minDelay: 300, addDelay: 500, timeout: 550 };
  else if(diff === "extreme") base = { minDelay: 180, addDelay: 350, timeout: 400 };
  else if(diff === "impossible") base = { minDelay: 120, addDelay: 220, timeout: 300 };

  if(isPhaseTwo) {
    base.minDelay = Math.round(base.minDelay * 0.8);
    base.addDelay = Math.round(base.addDelay * 0.8);
    base.timeout = Math.round(base.timeout * 0.85);
  }
  return base;
}

function updateHpUI() {
  $("player-hp-text").textContent = `${Math.max(0, playerHp)}/${playerMaxHp}`;
  $("player-hp-fill").style.width = `${Math.max(0, (playerHp / playerMaxHp) * 100)}%`;
  
  $("boss-hp-text").textContent = `${Math.max(0, bossHp)}/${bossMaxHp}`;
  $("boss-hp-fill").style.width = `${Math.max(0, (bossHp / bossMaxHp) * 100)}%`;

  if(!isPhaseTwo && bossHp <= bossMaxHp / 2 && bossHp > 0) {
    isPhaseTwo = true;
    $("phase-badge").style.display = "inline-block";
    $("message").textContent = "PHASE 2 STARTED! Boss hostility increased!";
  }
}

function waitNext(){
 if(!active)return;
 if(index>=total || playerHp <= 0 || bossHp <= 0){finish();return}
 waiting=false;canAttack=false;target="";currentComboHits=0;
 cue("DEFEND!", isPhaseTwo ? "⚡ PHASE 2 ATTACK INCOMING!" : "Watch for the attack signal!");
 const cfg = getDifficultySettings();
 const delay = cfg.minDelay + Math.random() * cfg.addDelay;
 gapTimer=setTimeout(()=>{
  if(!active)return;
  const bossKey = $("boss").value;
  const allowedMoves = bossStats[bossKey].moves;
  target=allowedMoves[Math.floor(Math.random()*allowedMoves.length)];
  waiting=true;shownAt=performance.now();cue(names[target],"REACT!",target);
  timer=setTimeout(()=>{
    if(waiting){
      waiting=false;
      results.push(false);
      const boss = bossStats[bossKey];
      playerHp -= boss.damage;
      updateHpUI();
      $("message").textContent=`Too slow! ${boss.name} hit you for ${boss.damage} DMG.`;
      update();
      index++;
      waitNext();
    }
  }, cfg.timeout);
 },delay);
}

function respond(action){
 if(!active)return;
 if(!waiting) return;
 
 clearTimeout(timer);waiting=false;
 const ms=Math.round(performance.now()-shownAt),ok=action===target;
 results.push(ok);
 const bossKey = $("boss").value;
 const boss = bossStats[bossKey];

 if(ok){
   hits++;
   times.push(ms);
   canAttack = true;
   currentComboHits = 0;
   const w = weapons[$("weapon").value];
   cue("OPENING WINDOW!", `CLICK TO COMBO! (Max ${w.maxCombo} Hit${w.maxCombo > 1 ? 's':''})`);
   $("message").textContent=`Defended successfully (${ms} ms)! CLICK LMB to strike back!`;
   clearTimeout(attackTimer);
   attackTimer = setTimeout(() => {
     if(canAttack && active) {
       canAttack = false;
       $("message").textContent = "Attack window closed!";
       index++; update(); waitNext();
     }
   }, 1300);
 } else {
   playerHp -= boss.damage;
   $("message").textContent=`Failed defence! Needed ${names[target]}. Took ${boss.damage} DMG.`;
   updateHpUI();
   index++; update(); waitNext();
 }
}

function playerAttack() {
  if(!active || !canAttack) return;
  const now = performance.now();
  const w = weapons[$("weapon").value];
  
  if(now - lastAttackTime < w.cooldown) return;
  
  lastAttackTime = now;
  currentComboHits++;
  bossHp -= w.dmg;
  updateHpUI();

  if(currentComboHits >= w.maxCombo) {
    canAttack = false;
    clearTimeout(attackTimer);
    $("message").textContent = `FULL COMBO! Dealt ${w.dmg * w.maxCombo} total DMG with ${w.name} weapon!`;
    index++; update();
    setTimeout(waitNext, 400);
  } else {
    $("message").textContent = `Hit ${currentComboHits}/${w.maxCombo}! Dealt ${w.dmg} DMG! Click again!`;
  }
}

function updateLeaderboard(name, score) {
  let board = JSON.parse(localStorage.getItem("global_leaderboard") || "[]");
  const existingIndex = board.findIndex(p => p.name === name);
  if(existingIndex !== -1) {
    board[existingIndex].score = Math.max(board[existingIndex].score, score);
  } else {
    board.push({ name, score });
  }
  board.sort((a, b) => b.score - a.score);
  board = board.slice(0, 5); // Топ-5
  localStorage.setItem("global_leaderboard", JSON.stringify(board));
  renderLeaderboard();
}

function renderLeaderboard() {
  let board = JSON.parse(localStorage.getItem("global_leaderboard") || "[]");
  if(board.length === 0) {
    board = [{ name: "Player1", score: totalPveScore }];
  }
  const tbody = $("leaderboard-body");
  tbody.innerHTML = board.map((p, i) => `
    <tr>
      <td><b>#${i + 1}</b></td>
      <td>${p.name}</td>
      <td><strong style="color:var(--accent)">${p.score} pts</strong></td>
    </tr>
  `).join("");
}

function update(){
 $("round").textContent=`${Math.min(index,total)}/${total}`;
 $("accuracy").textContent=results.length?Math.round(hits/results.length*100)+"%":"—";
 $("average").textContent=times.length?Math.round(times.reduce((a,b)=>a+b,0)/times.length)+" ms":"—";
 $("pve-score").textContent = totalPveScore;
}

function finish(){
 active=false;waiting=false;canAttack=false;enable(false);
 $("start").disabled=false;$("start").textContent="Start Combat";
 $("end-btn").disabled=true;
 
 const acc = results.length ? Math.round(hits/results.length*100) : 0;
 let scoreGained = 0;
 
 if(playerHp > 0) {
   if(acc === 100) scoreGained = 3;
   else if(acc >= 90) scoreGained = 2;
   else if(acc >= 40) scoreGained = 1;
 }

 if(scoreGained > 0) {
   totalPveScore += scoreGained;
   localStorage.setItem("pve_score", totalPveScore);
   const username = $("username").value.trim() || "Anonymous";
   updateLeaderboard(username, totalPveScore);
 }

 let endMsg = playerHp <= 0 ? "YOU DIED! The boss defeated you." : bossHp <= 0 ? "VICTORY! Boss Slain!" : "TRAINING FINISHED!";
 cue(endMsg, `Accuracy: ${acc}% · Gained +${scoreGained} PvE Score!`);
 $("message").textContent=times.length?`Average Reaction: ${Math.round(times.reduce((a,b)=>a+b,0)/times.length)} ms.`:"Game Over.";
 update();
}

function stopPractice(){
 if(!active) return;
 clearTimeout(timer);clearTimeout(gapTimer);clearTimeout(attackTimer);
 active=false;waiting=false;canAttack=false;enable(false);
 $("start").disabled=false;$("start").textContent="Start Combat";
 $("end-btn").disabled=true;
 cue("COMBAT ENDED", "Combat session was manually terminated.");
 $("message").textContent = "Practice ended by user.";
}

function startPractice(){
 clearTimeout(timer);clearTimeout(gapTimer);clearTimeout(attackTimer);
 const bossKey = $("boss").value;
 const b = bossStats[bossKey];
 bossMaxHp = bossHp = b.hp;
 playerMaxHp = playerHp = 600;
 isPhaseTwo = false;
 $("phase-badge").style.display = "none";
 $("boss-name-label").textContent = `${b.name} HP`;
 updateHpUI();

 active=true;waiting=false;canAttack=false;index=hits=0;times=[];results=[];total=Number($("rounds").value);
 $("start").disabled=true;$("start").textContent="In Combat…";
 $("end-btn").disabled=false;
 enable(true);
 update();
 waitNext();
}

document.addEventListener("click", (e) => {
  if(e.button === 0 && !e.target.closest("select") && !e.target.closest("button") && !e.target.closest("input")) {
    playerAttack();
  }
});

document.querySelectorAll("[data-action]").forEach(b=>b.addEventListener("click",()=>respond(b.dataset.action)));

document.addEventListener("keydown",e=>{
 if(!active) return;
 if(e.repeat) return;
 
 if(e.code === "KeyF"){e.preventDefault();respond("PARRY");return}
 if(e.code === "KeyQ"){e.preventDefault();respond("DODGE");return}
 if(e.code === "Space"){e.preventDefault();respond("JUMP");return}
 if(e.code === "ControlLeft" || e.code === "ControlRight" || e.key === "Control"){
   e.preventDefault();
   respond("CROUCH");
   return;
 }
});

renderLeaderboard();
$("pve-score").textContent = totalPveScore;
</script></body></html>
